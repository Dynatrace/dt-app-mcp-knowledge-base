{
  "name": "@dynatrace/dt-app-mcp-preprocessing",
  "version": "0.1.0",
  "private": true,
  "description": "Preprocessing pipeline that turns developer portal documentation into the dt-app-mcp knowledge base.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dt-app-mcp-preprocess": "src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "debug": "node --inspect-brk src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && npm run lint:json && npm run lint:markdown && npm run lint:workflows",
    "lint:json": "prettier --check ../meta.json ../schemas",
    "lint:markdown": "markdownlint-cli2 --config ../.markdownlint-cli2.yaml \"../**/*.md\"",
    "lint:workflows": "actionlint ../.github/workflows/*.yml"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fast-xml-parser": "^5.2.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "ajv-formats": "^3.0.1",
    "markdownlint-cli2": "^0.24.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
